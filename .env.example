# ============================================================================
# JM MAKER SPORTSWEAR — SUPABASE CLIENT ENVIRONMENT TEMPLATE
# Copy this file to `.env.local` and fill in your Supabase project values from:
#   Supabase Dashboard -> Project Settings -> API
#
# SECURITY WARNING:
#   NEVER put your Supabase `service_role` key in any `.env` file or `VITE_*`
#   variable! The frontend uses ONLY the public `anon` (publishable) key, and
#   all table access is enforced by PostgreSQL Row Level Security (RLS).
# ============================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-PUBLIC-KEY
